rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /recipes/{recipeId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /quota/{document=**} {
      allow read, write: if false;
    }

    match /system/{document=**} {
      allow read, write: if false;
    }
  }
}
